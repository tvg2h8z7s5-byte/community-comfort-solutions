{
  "name": "ccs-form-backend",
  "version": "1.0.0",
  "private": true,
  "description": "Tiny form-to-email backend for communitycomfortsolutions.org",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "node --test ../tests/public-backend.test.js ../tests/client-ip.test.js ../tests/accounts.test.js ../tests/billing-ui.test.js ../tests/scheduling-ui.test.js ../tests/inquiries-ui.test.js ../tests/maintenance-ui.test.js",
    "accounts:migrate": "node accounts/migrate.js --apply",
    "accounts:cleanup": "node accounts/migrate.js --cleanup",
    "accounts:check": "node accounts/check.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "multer": "^2.0.2",
    "nodemailer": "10.0.12",
    "pdfkit": "^0.20.2",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "jsdom": "^26.1.0"
  }
}
